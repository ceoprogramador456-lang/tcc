#pragma once

// Copie este arquivo para secrets.h e preencha antes de gravar no ESP32.
// secrets.h é gitignored — nunca commitar valores reais.
//
// A credencial do Wi-Fi não fica aqui: na primeira vez que o ESP32 liga sem
// rede salva, ele sobe o portal de configuração "SIVA-setup" e grava a senha na
// própria NVS. Ver firmware/src/wifi_manager.h.

// IP da máquina que roda o backend, na mesma rede do ESP32.
// Não usar "localhost" nem endereço de nuvem/codespace — o ESP32 não alcança.
#define API_HOST "192.168.0.10"
