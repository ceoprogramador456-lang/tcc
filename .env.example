# Ambiente
NODE_ENV=development
PORT=3000

# Ative para rodar a API 100% em memória (sem MySQL), ideal para o time de frontend
MOCK_MODE=false

# Banco de dados (ignorado quando MOCK_MODE=true)
DATABASE_URL="mysql://root:root@localhost:3306/siva_db"

# Autenticação de usuários (dashboard)
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=8h

# Pareamento ESP32: obrigatório em produção, estável entre reinícios/réplicas.
# Gere com: openssl rand -hex 32. Não use o mesmo valor do JWT_SECRET.
# DEVICE_PAIRING_SECRET=cole-aqui-o-segredo-gerado

# Credenciais exclusivas criadas por `npm run seed` (gere valores distintos).
# Gere cada senha com: openssl rand -hex 24
SEED_ADMIN_EMAIL=admin@siva.local
SEED_ADMIN_PASSWORD=
SEED_GESTOR_PASSWORD=
SEED_TECNICO_PASSWORD=

# Usuário ADMIN de exemplo, criado fora do seed (senha curta aceita só em dev):
#   npx tsx scripts/create-admin.ts <email> <senha>
# Exemplo criado neste ambiente: admin@etec.com / senha123

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
