// Espelha 1:1 a estrutura definida em db/db.sql.
// Qualquer alteração de schema deve ser feita nos dois lugares até migrarmos
// a fonte da verdade totalmente para Prisma Migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ADMIN
  GESTOR
  TECNICO

  @@map("tipo_usuario")
}

enum Especialidade {
  MECANICO
  ELETRICISTA

  @@map("especialidade")
}

enum StatusUsuario {
  ATIVO
  INATIVO

  @@map("status_usuario")
}

enum Criticidade {
  baixa
  media
  alta
}

enum TipoManutencao {
  preventiva
  corretiva
  inspecao
}

enum StatusManutencao {
  aberto
  em_andamento
  concluido
}

model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(100)
  cnpj      String?  @unique @db.VarChar(20)
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuarios Usuario[]
  setores  Setor[]

  @@map("empresa")
}

model Usuario {
  id            Int            @id @default(autoincrement())
  nome          String         @db.VarChar(100)
  email         String         @unique @db.VarChar(100)
  senha         String         @db.VarChar(255)
  tipo          TipoUsuario
  especialidade Especialidade?
  status        StatusUsuario  @default(ATIVO)
  empresaId     Int?           @map("empresa_id")
  criadoEm      DateTime       @default(now()) @map("criado_em")

  empresa      Empresa?      @relation(fields: [empresaId], references: [id])
  manutencoes  Manutencao[]

  @@map("usuario")
}

model Setor {
  id        Int      @id @default(autoincrement())
  empresaId Int      @map("empresa_id")
  nome      String   @db.VarChar(100)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  ativos  Ativo[]
  esp32s  Esp32[]

  @@map("setor")
}

model Ativo {
  id           Int         @id @default(autoincrement())
  setorId      Int         @map("setor_id")
  nome         String      @db.VarChar(100)
  tag          String?     @unique @db.VarChar(50)
  tipo         String?     @db.VarChar(50)
  criticidade  Criticidade @default(media)
  centroCusto  String?     @map("centro_custo") @db.VarChar(50)
  fotoUrl      String?     @map("foto_url") @db.VarChar(255)
  manualUrl    String?     @map("manual_url") @db.VarChar(255)
  descricao    String?     @db.VarChar(255)
  criadoEm     DateTime    @default(now()) @map("criado_em")

  setor   Setor    @relation(fields: [setorId], references: [id])
  sensores Sensor[]

  @@map("ativo")
}

model Esp32 {
  id             Int       @id @default(autoincrement())
  setorId        Int       @map("setor_id")
  espId          String    @unique @map("esp_id") @db.VarChar(50)
  macAddress     String?   @unique @map("mac_address") @db.VarChar(17)
  pairingEnabled Boolean   @default(false) @map("pairing_enabled")
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  descricao      String?   @db.VarChar(100)
  ultimoContato  DateTime? @map("ultimo_contato")
  criadoEm       DateTime  @default(now()) @map("criado_em")

  setor   Setor    @relation(fields: [setorId], references: [id])
  sensores Sensor[]
  pareamentos DevicePairing[]

  @@map("esp32")
}

model DevicePairing {
  id          String   @id @db.VarChar(36)
  macAddress  String   @unique @map("mac_address") @db.VarChar(17)
  sensorId    String   @map("sensor_id") @db.VarChar(50)
  secretHash  String   @map("secret_hash") @db.Char(64)
  codeHash    String   @unique @map("code_hash") @db.Char(64)
  status      String   @default("PENDING") @db.VarChar(16)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  deviceId    Int?     @map("device_id")
  device      Esp32?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("device_pairing")
}

model Sensor {
  id          Int      @id @default(autoincrement())
  ativoId     Int      @map("ativo_id")
  esp32Id     Int      @map("esp32_id")
  sensorId    String   @map("sensor_id") @db.VarChar(50)
  tag         String?  @unique @db.VarChar(50)
  descricao   String?  @db.VarChar(100)
  ativoStatus Boolean  @default(true) @map("ativo_status")
  criadoEm    DateTime @default(now()) @map("criado_em")

  ativo        Ativo        @relation(fields: [ativoId], references: [id])
  esp32        Esp32        @relation(fields: [esp32Id], references: [id])
  leituras     Leitura[]
  manutencoes  Manutencao[]

  @@unique([esp32Id, sensorId])
  @@map("sensor")
}

model Leitura {
  id            BigInt   @id @default(autoincrement())
  sensorId      Int      @map("sensor_id")
  vazao         Float
  registradoEm  DateTime @default(now()) @map("registrado_em")

  sensor Sensor @relation(fields: [sensorId], references: [id])

  @@index([sensorId, registradoEm], name: "idx_leitura_sensor_data")
  @@map("leitura")
}

model Manutencao {
  id            Int               @id @default(autoincrement())
  sensorId      Int               @map("sensor_id")
  tipo          TipoManutencao
  status        StatusManutencao  @default(aberto)
  descricao     String?           @db.Text
  funcionarioId Int?              @map("funcionario_id")
  abertoEm      DateTime          @default(now()) @map("aberto_em")
  concluidoEm   DateTime?         @map("concluido_em")

  sensor      Sensor   @relation(fields: [sensorId], references: [id])
  funcionario Usuario? @relation(fields: [funcionarioId], references: [id])

  @@index([status], name: "idx_manutencao_status")
  @@map("manutencao")
}
